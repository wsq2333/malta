{
  "name": "同一用例的 UCE 与 Argo 模板",
  "body": {
    "schema_version": "workflow/v1alpha1",
    "timeout_seconds": 600,
    "implementations": {
      "uce": {
        "template": {
          "schema_version": "0.1.0",
          "root_dag_version_id": "11111111-1111-4111-8111-111111111101",
          "dag_definitions": [
            {
              "dag_id": "66666666-6666-4666-8666-666666666611",
              "dag_version_id": "11111111-1111-4111-8111-111111111101",
              "version": "1.0.0",
              "name": "malta-evidence-smoke",
              "inputs": [],
              "outputs": [],
              "nodes": [
                {
                  "definition_node_id": "66666666-6666-4666-8666-666666666601",
                  "name": "source-node",
                  "kind": "operator",
                  "target_version_id": "22222222-2222-4222-8222-222222222202",
                  "input_bindings": {},
                  "input_path": []
                }
              ],
              "output_bindings": {}
            }
          ],
          "operator_definitions": [
            {
              "resource_pool": "ecs",
              "operator_id": "22222222-2222-4222-8222-222222222201",
              "operator_version_id": "22222222-2222-4222-8222-222222222202",
              "version": "1.0.0",
              "name": "source",
              "inputs": [],
              "outputs": [],
              "manifest": {
                "apiVersion": "v1",
                "kind": "Pod",
                "metadata": {
                  "name": "source"
                },
                "spec": {
                  "restartPolicy": "Never",
                  "containers": [
                    {
                      "name": "main",
                      "image": "python:3.12-alpine",
                      "command": [
                        "python",
                        "-c"
                      ],
                      "args": [
                        "print(\"hello from native UCE template\")"
                      ],
                      "resources": {
                        "requests": {
                          "cpu": "100m",
                          "memory": "64Mi"
                        },
                        "limits": {
                          "cpu": "1",
                          "memory": "128Mi"
                        }
                      }
                    }
                  ]
                }
              },
              "output_path": [],
              "execution": {
                "maxRetry": 0
              }
            }
          ],
          "artifact_contract": "paths-v1"
        }
      },
      "argo": {
        "template": {
          "apiVersion": "argoproj.io/v1alpha1",
          "kind": "WorkflowTemplate",
          "metadata": {
            "name": "malta-native-hello"
          },
          "spec": {
            "entrypoint": "hello",
            "templates": [
              {
                "name": "hello",
                "container": {
                  "image": "alpine:3.20",
                  "command": [
                    "sh",
                    "-c"
                  ],
                  "args": [
                    "echo hello from native Argo template"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
