{
  "name": "Argo 原生模板示例",
  "description": "完整原生模板；不配置结果解析",
  "body": {
    "schema_version": "workflow/v1alpha1",
    "backend": "argo",
    "template": {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "WorkflowTemplate",
      "metadata": {
        "name": "malta-native-hello"
      },
      "spec": {
        "entrypoint": "hello",
        "templates": [
          {
            "name": "hello",
            "container": {
              "image": "alpine:3.20",
              "command": [
                "sh",
                "-c"
              ],
              "args": [
                "echo hello from native Argo template"
              ]
            }
          }
        ]
      }
    },
    "timeout_seconds": 600
  }
}
