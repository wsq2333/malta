bin/
.malta/
results/
/plan.json
web/node_modules/
web/dist/*
!web/dist/.gitkeep
*.db
*.db-shm
*.db-wal
*.log
.DS_Store
coverage.out

/build/output/
/release/

# Local configuration is private by default; only these reviewed examples are tracked.
/config/**
!/config/README.md
!/config/deploy/
!/config/parameter/
!/config/llm/
!/config/deploy/kubeconfig.example.yaml
!/config/parameter/executor.example.yaml
!/config/parameter/application.example.yaml
!/config/llm/providers.example.yaml

!/config/parameter/workflow.example.yaml

!/config/parameter/workflow-backends.example.yaml

# Runtime credentials are local only. Never put real values in allowed examples.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.token
*.secret
*.secret.json
*.secret.yaml
*.secret.yml
secret.json
secret.yaml
secret.yml
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
kubeconfig
kubeconfig.json
kubeconfig.yaml
kubeconfig.yml
/secrets/
/credentials/
/local/

# Rendered environment-bound templates and parameters; example names do not match.
*.local.json
*.local.yaml
*.local.yml
*.ep.json
*.ep.yaml
*.ep.yml
*.case.json
*.parameters.json
*.parameters.yaml
*.parameters.yml
*.template.json
*.template.yaml
*.template.yml

# Workflow examples are an explicit allowlist, not a general *.example.* exception.
/docs/examples/workflow/**
!/docs/examples/workflow/argo-evidence.example.json
!/docs/examples/workflow/case.example.json
!/docs/examples/workflow/multi-backend.example.json
!/docs/examples/workflow/native-argo.example.json
!/docs/examples/workflow/native-uce.example.json
!/docs/examples/workflow/profile.example.json
!/docs/examples/workflow/selection.example.json
!/docs/examples/workflow/system.example.json
!/docs/examples/workflow/oss-fuse-fio.ep.example.json
!/docs/examples/workflow/oss-fuse-fio.case.example.json
!/docs/examples/workflow/oss-fuse-fio.parameters.example.json
!/docs/examples/workflow/oss-fuse-fio.parameters-256gib.example.json

# Keep only portable deployment examples in overlays; real overlays belong in config/deploy.
/deploy/kubernetes/overlays/**
!/deploy/kubernetes/overlays/example/
!/deploy/kubernetes/overlays/example/executor.json
!/deploy/kubernetes/overlays/management/
!/deploy/kubernetes/overlays/management/README.md
!/deploy/kubernetes/overlays/workflow/
!/deploy/kubernetes/overlays/workflow/README.md
!/deploy/kubernetes/overlays/workflow/endpoints.example.yaml

# Generated tool manifests/configuration must not sit beside versioned source files.
/tools/marea-test-tools/**/*.json
/tools/marea-test-tools/**/*.yaml
/tools/marea-test-tools/**/*.yml
