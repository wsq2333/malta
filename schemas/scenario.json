{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malta.local/schemas/scenario.json",
  "$ref": "#/$defs/ScenarioSpec",
  "$defs": {
    "ScenarioSpec": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "scenario/v1alpha1"
          ]
        },
        "name": {
          "type": "string"
        },
        "repeats": {
          "type": "integer"
        },
        "failure_policy": {
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "name",
        "repeats",
        "failure_policy",
        "stages"
      ]
    },
    "ScenarioWorkload": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "numjobs": {
          "type": "integer"
        },
        "iodepth": {
          "type": "integer"
        },
        "workload": {
          "$ref": "#/$defs/Workload"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "kind",
        "numjobs",
        "iodepth",
        "workload"
      ]
    },
    "Stage": {
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "warmup_seconds": {
          "type": "integer"
        },
        "runtime_seconds": {
          "type": "integer"
        },
        "dataset_policy": {
          "type": "string"
        },
        "workloads": {
          "items": {
            "$ref": "#/$defs/ScenarioWorkload"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "mode",
        "warmup_seconds",
        "runtime_seconds",
        "dataset_policy",
        "workloads"
      ]
    },
    "Workload": {
      "properties": {
        "operation": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "files_per_job": {
          "type": "integer"
        },
        "block_size_bytes": {
          "type": "integer"
        },
        "read_percent": {
          "type": "integer"
        },
        "ioengine": {
          "type": "string"
        },
        "direct": {
          "type": "boolean"
        },
        "cache_state": {
          "type": "string"
        },
        "fsync_every": {
          "type": "integer"
        },
        "runtime_seconds": {
          "type": "integer"
        },
        "warmup_seconds": {
          "type": "integer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "operation",
        "file_size_bytes",
        "files_per_job",
        "block_size_bytes",
        "read_percent",
        "ioengine",
        "direct",
        "cache_state",
        "fsync_every",
        "runtime_seconds",
        "warmup_seconds",
        "seed"
      ]
    }
  }
}
