{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malta.local/schemas/spec.json",
  "$ref": "#/$defs/Spec",
  "$defs": {
    "Matrix": {
      "properties": {
        "numjobs": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "iodepth": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "numjobs",
        "iodepth"
      ]
    },
    "Spec": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "workload": {
          "$ref": "#/$defs/Workload"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix"
        },
        "repeats": {
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "name",
        "kind",
        "workload",
        "matrix",
        "repeats"
      ]
    },
    "Workload": {
      "properties": {
        "operation": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "files_per_job": {
          "type": "integer"
        },
        "block_size_bytes": {
          "type": "integer"
        },
        "read_percent": {
          "type": "integer"
        },
        "ioengine": {
          "type": "string"
        },
        "direct": {
          "type": "boolean"
        },
        "cache_state": {
          "type": "string"
        },
        "fsync_every": {
          "type": "integer"
        },
        "runtime_seconds": {
          "type": "integer"
        },
        "warmup_seconds": {
          "type": "integer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "operation",
        "file_size_bytes",
        "files_per_job",
        "block_size_bytes",
        "read_percent",
        "ioengine",
        "direct",
        "cache_state",
        "fsync_every",
        "runtime_seconds",
        "warmup_seconds",
        "seed"
      ]
    }
  }
}
