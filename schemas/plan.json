{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malta.local/schemas/plan.json",
  "$ref": "#/$defs/Plan",
  "$defs": {
    "Environment": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "machines": {
          "items": {
            "$ref": "#/$defs/Machine"
          },
          "type": "array"
        },
        "os": {
          "type": "string"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "name",
        "kind",
        "provider",
        "region",
        "machines",
        "os",
        "config"
      ]
    },
    "Machine": {
      "properties": {
        "role": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "cpu": {
          "type": "string"
        },
        "memory_bytes": {
          "type": "integer"
        },
        "storage": {
          "type": "string"
        },
        "network": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "role",
        "model",
        "count",
        "cpu",
        "memory_bytes",
        "storage",
        "network"
      ]
    },
    "Matrix": {
      "properties": {
        "numjobs": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "iodepth": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "numjobs",
        "iodepth"
      ]
    },
    "Plan": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "spec": {
          "$ref": "#/$defs/Spec"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "version": {
          "$ref": "#/$defs/SoftwareVersion"
        },
        "target": {
          "type": "string"
        },
        "resource_group": {
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "type": "array"
        },
        "hash": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "spec",
        "environment",
        "version",
        "target",
        "resource_group",
        "trials",
        "hash"
      ]
    },
    "Point": {
      "properties": {
        "id": {
          "type": "string"
        },
        "numjobs": {
          "type": "integer"
        },
        "iodepth": {
          "type": "integer"
        },
        "repeat": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "numjobs",
        "iodepth",
        "repeat"
      ]
    },
    "SoftwareVersion": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "id": {
          "type": "string"
        },
        "filesystem": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "build": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "filesystem",
        "label",
        "commit",
        "build"
      ]
    },
    "Spec": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "workload": {
          "$ref": "#/$defs/Workload"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix"
        },
        "repeats": {
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "name",
        "kind",
        "workload",
        "matrix",
        "repeats"
      ]
    },
    "Workload": {
      "properties": {
        "operation": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "files_per_job": {
          "type": "integer"
        },
        "block_size_bytes": {
          "type": "integer"
        },
        "read_percent": {
          "type": "integer"
        },
        "ioengine": {
          "type": "string"
        },
        "direct": {
          "type": "boolean"
        },
        "cache_state": {
          "type": "string"
        },
        "fsync_every": {
          "type": "integer"
        },
        "runtime_seconds": {
          "type": "integer"
        },
        "warmup_seconds": {
          "type": "integer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "operation",
        "file_size_bytes",
        "files_per_job",
        "block_size_bytes",
        "read_percent",
        "ioengine",
        "direct",
        "cache_state",
        "fsync_every",
        "runtime_seconds",
        "warmup_seconds",
        "seed"
      ]
    }
  }
}
