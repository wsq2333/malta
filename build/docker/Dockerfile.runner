ARG BASE_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
FROM ${BASE_IMAGE}
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends fio=3.33-3 && test "$(fio --version)" = fio-3.33 && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 build/output/malta-linux-${TARGETARCH} /usr/local/bin/malta
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/malta/
COPY build/output/licenses /usr/share/doc/malta/licenses
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/malta"]
CMD ["worker"]
