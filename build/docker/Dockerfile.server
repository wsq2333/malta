# Build Go + embedded UI first using scripts/release.sh (or the documented build commands).
ARG BASE_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
FROM ${BASE_IMAGE}
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 build/output/malta-linux-${TARGETARCH} /usr/local/bin/malta
COPY --chmod=755 build/output/kubectl-linux-${TARGETARCH} /usr/local/bin/kubectl
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/malta"]
CMD ["serve", "--listen", "0.0.0.0:8080", "--data-dir", "/var/lib/malta", "--kubernetes-config", "/etc/malta/executor.json"]
